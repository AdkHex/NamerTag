{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NamerTag",
  "version": "1.3.0",
  "identifier": "com.adkhex.namertag",
  "build": {
    "removeUnusedCommands": true,
    "beforeDevCommand": "pnpm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "NamerTag",
        "width": 1440,
        "height": 900,
        "minWidth": 1000,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false,
        "maximized": false,
        "center": true,
        "decorations": false,
        "alwaysOnTop": false,
        "transparent": true,
        "shadow": true,
        "dragDropEnabled": true,
        "windowEffects": {
          "effects": [
            "hudWindow"
          ],
          "radius": 12,
          "state": "active"
        }
      }
    ],
    "security": {
      "csp": null
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "createUpdaterArtifacts": true,
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "AdkHex",
    "category": "DeveloperTool",
    "shortDescription": "Edit video file metadata.",
    "longDescription": "NamerTag is a Tauri desktop app for renaming and editing video file metadata using ffmpeg.",
    "copyright": "Copyright © 2025 AdkHex. All rights reserved.",
    "macOS": {
      "frameworks": [],
      "minimumSystemVersion": "10.15",
      "signingIdentity": "-",
      "providerShortName": null,
      "entitlements": null,
      "exceptionDomain": ""
    }
  },
  "plugins": {
    "updater": {
      "active": true,
      "endpoints": [
        "https://github.com/AdkHex/NamerTag/releases/latest/download/latest.json"
      ],
      "dialog": false,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEM1RTlGOTA1RjhFODU5RTQKUldUa1dlajRCZm5weFZKenJFVmhMeGVlRHVkbmFJOG43MGJCRmV4MXNudWFtMVVPY2k4ZmZIZkgK"
    }
  }
}
